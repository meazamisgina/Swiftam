# Swiftiom marketing site (Ethiopia stack example)
# Rebuild after changing NEXT_PUBLIC_* (baked in at `npm run build`).

# Public API — same host as USA; tiers are selected by region below.
NEXT_PUBLIC_API_BASE_URL=https://api.swiftiom.com

# Optional: server-side fetch override if SSR cannot use the public URL.
# SERVER_API_BASE_URL=https://api.swiftiom.com

# Pricing region: USA (default) or ETHIOPIA → maps data.regions.ETHIOPIA.tiers
NEXT_PUBLIC_PRICING_REGION=ETHIOPIA

NEXT_PUBLIC_APP_URL=https://app.swiftiom.com
NEXT_PUBLIC_MARKETING_URL=https://www.example-ethiopia.tld
